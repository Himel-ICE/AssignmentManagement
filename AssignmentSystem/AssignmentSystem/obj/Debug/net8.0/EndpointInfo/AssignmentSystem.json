  "components": {
    "schemas": {
      "CreateAcademicClassDto": {
        "required": [
          "department",
          "name",
          "section",
          "semester"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "department": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "semester": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "section": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CreateAssignmentDto": {
        "required": [
          "deadline",
          "description",
          "teacherClassSubjectId",
          "title"
        ],
        "type": "object",
        "properties": {
          "teacherClassSubjectId": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          },
          "maximumMarks": {
            "maximum": 1000,
            "minimum": 1,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateSubjectDto": {
        "required": [
          "code",
          "name"
        ],
        "type": "object",
        "properties": {
          "code": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "credit": {
            "maximum": 10,
            "minimum": 0.5,
            "type": "number",
            "format": "double"
          },
          "description": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CreateSubmissionDto": {
        "required": [
          "answer",
          "assignmentId"
        ],
        "type": "object",
        "properties": {
          "assignmentId": {
            "type": "integer",
            "format": "int32"
          },
          "answer": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateTeacherClassSubjectDto": {
        "required": [
          "academicClassId",
          "subjectId",
          "teacherId"
        ],
        "type": "object",
        "properties": {
          "teacherId": {
            "type": "integer",
            "format": "int32"
          },
          "academicClassId": {
            "type": "integer",
            "format": "int32"
          },
          "subjectId": {
            "type": "integer",
            "format": "int32"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
